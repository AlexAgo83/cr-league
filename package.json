{
  "name": "cr-league",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf apps/api/dist apps/web/dist packages/shared/dist apps/api/tsconfig.tsbuildinfo apps/web/tsconfig.tsbuildinfo packages/shared/tsconfig.tsbuildinfo reports tmp .cache coverage test-results playwright-report",
    "dev": "node scripts/dev-local.mjs",
    "dev:stop": "node scripts/stop-dev.mjs",
    "dev:api": "npm run dev -w @cr-league/api",
    "dev:web": "npm run dev -w @cr-league/web",
    "build": "npm run build -w @cr-league/shared && npm run build -w @cr-league/api && npm run build -w @cr-league/web",
    "typecheck": "tsc -b && tsc -p scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "playtest:seed": "tsx scripts/seed-playtest-league.ts",
    "db:studio": "prisma studio",
    "smoke:league": "tsx scripts/smoke-league-flow.ts",
    "playtest:simulate": "tsx scripts/simulate-playtest.ts",
    "playtest:ai": "tsx scripts/ai-playtest.ts",
    "playtest:browser": "tsx scripts/browser-playtest.ts",
    "playtest:browser:fun": "tsx scripts/browser-fun-score.ts --rounds 2 --profiles sprinter,rain-reader,banker,closer --report reports/playtest/browser-fun-score.md",
    "playtest:brain:selftest": "tsx scripts/playtestBrain.selftest.ts",
    "playtest:ux": "tsx scripts/browser-playtest.ts --rounds 2 --ux-report reports/ux/browser-playthrough.md --report reports/playtest/browser-playtest-smoke.md",
    "playtest:ux:cold-start": "tsx scripts/browser-playtest.ts --cold-start-report reports/ux/cold-start-funnel.md",
    "copy:audit": "tsx scripts/copy-comprehension-audit.ts --report reports/ux/copy-comprehension.md",
    "perf:browser": "tsx scripts/perf-browser-runtime.ts",
    "perf:browser:attached": "tsx scripts/perf-browser-runtime.ts --no-server",
    "perf:replay": "tsx scripts/perf-browser-runtime.ts --mode replay --report reports/perf/replay-runtime.md --json reports/perf/replay-runtime.json",
    "perf:compare": "tsx scripts/perf-compare.ts",
    "perf:bundle": "tsx scripts/perf-bundle.ts",
    "perf:api": "node --expose-gc --import tsx scripts/perf-api.ts",
    "playtest:replayability": "tsx scripts/replayability-analytics.ts --seasons 12 --rounds 6 --report reports/playtest/replayability-analytics.md --json reports/playtest/replayability-analytics.json",
    "replay:validate": "tsx scripts/validate-replay-trace.ts",
    "replay:inspect": "tsx scripts/inspect-replay-trace.ts",
    "balance:sim": "tsx scripts/balance-simulations.ts",
    "balance:gate": "tsx scripts/balance-simulations.ts --runs 1 --circuits 4 --limit 8 --max-gap-pct 25 --max-pit-points-spread 4.5",
    "generate:circuit": "node scripts/generate-circuit.mjs",
    "generate:circuit-wave": "node scripts/generate-circuit-wave.mjs",
    "import:circuits": "node scripts/import-generated-circuits.mjs",
    "generate:speed-profiles": "node scripts/generate-circuit-speed-profiles.mjs",
    "audit:circuits": "node scripts/audit-circuits.mjs",
    "review:circuits:water": "node scripts/review-circuit-water.mjs",
    "logics:validate": "logics-manager lint --require-status && logics-manager audit --group-by-doc",
    "capture:screenshots": "tsx scripts/capture-screenshots.ts",
    "playtest:solo": "tsx scripts/solo-playtest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@grifhinz/logics-manager": "^2.19.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
