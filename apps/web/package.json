{
  "name": "@cr-league/web",
  "version": "0.8.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4873 --strictPort",
    "build": "tsc -b && node scripts/validate-api-base-url.mjs && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "preview:pwa": "VITE_API_BASE_URL=https://example.com npm run build && vite preview --port 4873",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@cr-league/shared": "0.8.5",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
